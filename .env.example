# Kuk — daftar environment variable.
# Salin file ini jadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local.

# ---------- Publik (boleh terbaca di browser, awalan NEXT_PUBLIC_) ----------
# Alamat contract koin Kuk. Kosongkan sampai koin launch.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Privy App ID (dashboard.privy.io > App settings). Publik, aman di browser.
NEXT_PUBLIC_PRIVY_APP_ID=
# mainnet-beta atau devnet
NEXT_PUBLIC_SOLANA_NETWORK=

# ---------- AI teks (hanya dibaca server, bukan rahasia) ----------
# Provider AI teks yang dipakai src/lib/ai. Tersedia: groq. (gemini / openai menyusul)
AI_TEXT_PROVIDER=groq
# Opsional. Kosong = openai/gpt-oss-120b.
# Harus model Groq yang mendukung strict JSON schema: openai/gpt-oss-120b atau openai/gpt-oss-20b.
GROQ_TEXT_MODEL=

# ---------- AI gambar (hanya dibaca server, bukan rahasia) ----------
# Provider gambar yang dipakai src/lib/ai. Tersedia: cloudflare (FLUX.1 schnell).
AI_IMAGE_PROVIDER=cloudflare
# Opsional. Jumlah steps FLUX.1 schnell, 1–8. Kosong = 4.
# Lebih sedikit = lebih hemat neuron: 4 steps ≈ 57,6 neuron/gambar (~173 gambar/hari gratis).
CLOUDFLARE_IMAGE_STEPS=

# ---------- Filter isi (hanya dibaca server, bukan rahasia) ----------
# Provider moderasi yang dipakai src/lib/ai. Tersedia:
#   groq   (default, gratis, pakai GROQ_API_KEY yang sama dengan teks. Hanya memeriksa teks.)
#   openai (bisa memeriksa gambar sekaligus, tapi wajib kartu + $5 kredit awal di akun OpenAI)
AI_MODERATION_PROVIDER=groq
# Opsional. Kosong = omni-moderation-latest. Hanya dipakai kalau AI_MODERATION_PROVIDER=openai.
OPENAI_MODERATION_MODEL=

# ---------- Membuat koin pump.fun / fitur Serve (bukan rahasia) ----------
# Cara membuat koin. Tersedia:
#   pumpportal (default) = PumpPortal Local Transaction API. Koin sungguhan, mainnet.
#                          Pembelian awal boleh 0, dan kalau 0 maka potongan 0,5% mereka juga 0.
#                          Mode Lightning TIDAK dipakai: itu menitipkan private key ke pihak lain.
#   pumpfun              = API resmi pump.fun. Pembelian awal WAJIB di atas 0.
#   devnet               = token LATIHAN di devnet, gratis, untuk mengetes alurnya.
# pump.fun tidak punya devnet, jadi mode devnet membuat token SPL biasa yang
# struktur transaksinya sama (2 tanda tangan: wallet user + mint baru).
LAUNCH_PROVIDER=pumpportal
# Opsional. Kosong = https://api.devnet.solana.com (RPC publik gratis).
SOLANA_DEVNET_RPC_URL=

# ---------- Rahasia (HANYA dipakai di server / API route) ----------
# Privy App Secret. Dipakai src/lib/privy-server.ts untuk verifikasi login.
PRIVY_APP_SECRET=
# Groq API key (console.groq.com/keys). Dipakai src/lib/ai/providers/groq.ts.
GROQ_API_KEY=
# Cloudflare Workers AI: Account ID + API token dengan izin "Workers AI - Read" dan "Workers AI - Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Supabase (Settings → API Keys). Secret key diawali sb_secret_ dan hanya untuk server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# OpenAI API key (platform.openai.com/api-keys). Hanya dipakai kalau AI_MODERATION_PROVIDER=openai.
OPENAI_API_KEY=
# Pinata JWT (app.pinata.cloud → API Keys → New Key, izin Files = Write).
# Dipakai untuk upload gambar + metadata koin ke IPFS.
PINATA_JWT=
# Opsional tapi disarankan. Gateway khusus akun Pinata Anda (app.pinata.cloud → Gateways),
# contoh: mawar-tiger-1234.mypinata.cloud — tulis tanpa https://
# Kosong = pakai ipfs.io, yang gratis tapi kadang menolak permintaan rapat (HTTP 429).
# Alamat ini tersimpan permanen di blockchain, jadi pilih sebelum mint koin sungguhan.
PINATA_GATEWAY=
# Alamat RPC Solana mainnet (https://...). Dipakai untuk simulasi dan pengiriman transaksi.
# Wajib diisi untuk mainnet; devnet punya RPC publik bawaan jadi tidak perlu diisi.
# Gratis tanpa daftar (cukup untuk mencoba, tapi kena rate limit kalau ramai):
#   https://rpc.solanatracker.io/public
#   https://solana-rpc.publicnode.com
# Untuk dipakai sungguhan, ambil RPC sendiri (misalnya Helius atau QuickNode, ada paket gratis).
SOLANA_RPC_URL=
