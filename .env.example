# Coook — daftar environment variable.
# Salin file ini jadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local.

# ---------- Publik (boleh terbaca di browser, awalan NEXT_PUBLIC_) ----------
# Alamat contract koin Coook. Kosongkan sampai koin launch.
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Privy App ID (dashboard.privy.io > App settings). Publik, aman di browser.
NEXT_PUBLIC_PRIVY_APP_ID=
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# mainnet-beta atau devnet
NEXT_PUBLIC_SOLANA_NETWORK=

# ---------- AI teks (hanya dibaca server, bukan rahasia) ----------
# Provider AI teks yang dipakai src/lib/ai. Tersedia: groq. (gemini / openai menyusul)
AI_TEXT_PROVIDER=groq
# Opsional. Kosong = openai/gpt-oss-120b.
# Harus model Groq yang mendukung strict JSON schema: openai/gpt-oss-120b atau openai/gpt-oss-20b.
GROQ_TEXT_MODEL=

# ---------- Rahasia (HANYA dipakai di server / API route) ----------
# Privy App Secret. Dipakai src/lib/privy-server.ts untuk verifikasi login.
PRIVY_APP_SECRET=
# Groq API key (console.groq.com/keys). Dipakai src/lib/ai/providers/groq.ts.
GROQ_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
SOLANA_RPC_URL=
